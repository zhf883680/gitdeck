{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitdeck",
  "version": "0.1.0",
  "identifier": "dev.zhoufeng.gitdeck",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "本地 Git 分支工作台",
    "longDescription": "快速清理分支、对比分支差异、用本地 Codex 解释改动。"
  }
}